# Data and generated artifacts (large, not committed — per CLAUDE.md)
data/
output/

# ...except the toy example's data, which MUST ship: it is the only way to run
# the pipeline without the municipal layers (roadmap Track B). The directory has
# to be un-ignored before the files, because git does not descend into an
# excluded directory to evaluate a negation inside it.
!examples/toy/data/
!examples/toy/data/**

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Scratch / temp
scratchpad/
*.tmp
*.log
*.bak

# Stray scratch file (roadmap P4 item 12)
wb.html

# Parameter-sweep / one-off debug artifacts — not the tracked baseline files
# (QC/competing_pipe_review.csv, .gpkg) they're variants or traces of.
QC/competing_pipe_review_edge*.csv
QC/trace_*.gpkg

# Dated check-in reports — working notes, not portfolio-facing.
docs/*_checkin_*.html

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Census API key (secret — never commit)
.census_api_key
